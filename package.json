{
  "name": "vrc-event-viewer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nuxt",
    "build": "nuxt build",
    "start": "nuxt start --hostname 0.0.0.0 --port 3030",
    "staging": "nuxt start --hostname 0.0.0.0 --port 3000",
    "generate": "nuxt generate",
    "lint:js": "eslint --ext .ts,.js,.vue --ignore-path .gitignore .",
    "lint": "yarn lint:js"
  },
  "lint-staged": {
    "*.{js,vue}": "eslint"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "dependencies": {
    "@nuxt/typescript-runtime": "^2.1.0",
    "@nuxtjs/axios": "^5.13.6",
    "core-js": "^3.46.0",
    "express": "^4.21.2",
    "mysql": "^2.18.1",
    "nuxt": "^2.18.1",
    "nuxt-compress": "^5.0.0",
    "sanitize-html": "~2.7.3"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@nuxt/types": "^2.18.1",
    "@nuxt/typescript-build": "^2.1.0",
    "@nuxtjs/eslint-config": "^8.0.0",
    "@nuxtjs/eslint-config-typescript": "^8.0.0",
    "@nuxtjs/eslint-module": "^3.1.0",
    "@nuxtjs/google-gtag": "^1.0.4",
    "@nuxtjs/vuetify": "^1.12.3",
    "babel-eslint": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-nuxt": "^4.0.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2"
  }
}
